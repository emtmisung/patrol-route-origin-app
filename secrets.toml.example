# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하고 실제 값을 입력하세요.
# secrets.toml은 .gitignore에 들어 있어 GitHub에 올라가지 않습니다. 절대 공개 저장소에 올리지 마세요.
# Streamlit Cloud에서는 앱 Settings → Secrets 에 같은 내용을 붙여넣습니다.
APP_PASSWORD = "여기에_앱_접속_비밀번호_입력"
NCP_CLIENT_ID = "여기에_Client_ID_입력"
NCP_CLIENT_SECRET = "여기에_Client_Secret_입력"

# 선택 항목
# MOBILE_TRANSFER_SECRET = "휴대폰 전달 QR 암호화용 값 (없으면 NCP 키로 대신함)"
# APP_PUBLIC_URL = "https://faseru-origin.streamlit.app/"
