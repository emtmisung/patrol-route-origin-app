# 이 파일을 복사해서 .streamlit/secrets.toml 로 저장하고 실제 값을 입력하세요.
# secrets.toml은 .gitignore에 들어 있어 GitHub에 올라가지 않습니다. 절대 공개 저장소에 올리지 마세요.
# Streamlit Cloud에서는 앱 Settings → Secrets 에 같은 내용을 붙여넣습니다.
APP_PASSWORD = "여기에_앱_접속_비밀번호_입력"
NCP_CLIENT_ID = "여기에_Client_ID_입력"
NCP_CLIENT_SECRET = "여기에_Client_Secret_입력"

# 선택 항목
# MOBILE_TRANSFER_SECRET = "휴대폰 전달 QR 암호화용 값 (없으면 NCP 키로 대신함)"
# APP_PUBLIC_URL = "https://faseru-origin.streamlit.app/"

# 관리자 화면(주소 뒤에 ?admin=1) 비밀번호 — 일반 APP_PASSWORD와 다른 값을 권장
# ADMIN_PASSWORD = "여기에_관리자_비밀번호_입력"

# 월별 API 사용량을 구글시트에 기록하려면 아래 두 값을 등록하세요(둘 다 없으면 사용량 기록·표시를 건너뜁니다).
# 1) 구글클라우드 콘솔에서 서비스 계정을 만들고 키(JSON)를 발급받아 그대로 문자열로 붙여넣습니다.
# 2) 사용량을 기록할 구글시트를 만들고, 그 시트를 위 서비스 계정 이메일에 "편집자"로 공유합니다.
# 3) 시트 주소의 .../d/ 와 /edit 사이 긴 문자열이 GSHEET_SPREADSHEET_ID입니다.
# GSHEET_SERVICE_ACCOUNT = '''{"type": "service_account", "project_id": "...", ...}'''
# GSHEET_SPREADSHEET_ID = "여기에_구글시트_ID_입력"
